# Supabase プロジェクト URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Secret key（sb_secret_... で始まる。サーバー専用・絶対に NEXT_PUBLIC_ を付けない）
# Dashboard > Project Settings > API Keys > Secret keys で取得
# ※ legacy API keys を無効化していない場合は旧 service_role JWT を SUPABASE_SERVICE_ROLE_KEY に入れても可
SUPABASE_SECRET_KEY=

# Basic 認証（未設定なら認証スキップ = ローカル開発向け）。記号を使う場合は値をシングルクォートで囲む
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Cron エンドポイント保護用のシークレット（openssl rand -hex 32 で生成）
# Vercel で設定すると Cron 実行時に Authorization: Bearer <値> が自動付与される
CRON_SECRET=
